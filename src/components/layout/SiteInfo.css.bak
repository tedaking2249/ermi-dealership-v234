.site-info {
  margin-top: var(--spacing-xl);
  background-color: var(--white);
  color: var(--ink);
}

.site-info-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: var(--spacing-xl) var(--spacing-md);
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-xl);
}

.site-info-block {
  scroll-margin-top: 80px;
}

.site-info-block h2 {
  margin: 0 0 var(--spacing-md);
  font-size: var(--font-size-lg);
  color: var(--navy);
}

.site-info-block p {
  margin: 0 0 var(--spacing-sm);
  line-height: 1.65;
  color: var(--sub);
}

.site-info-highlights {
  list-style: none;
  margin: var(--spacing-md) 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.site-info-highlights li {
  position: relative;
  padding-left: 22px;
  color: var(--sub);
  font-size: var(--font-size-sm);
}

.site-info-highlights li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--navy);
}

.site-info-contact {
  list-style: none;
  margin: 0 0 var(--spacing-md);
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.site-info-contact li {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
  color: var(--sub);
  line-height: 1.5;
}

.site-info-contact svg {
  flex-shrink: 0;
  margin-top: 2px;
  font-size: 1.3rem;
  color: var(--navy);
}

.site-info-contact a {
  color: var(--ink);
}

.site-info-contact a:hover {
  text-decoration: underline;
}

.site-info-hours-line {
  display: block;
}

.site-info-social {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.site-info-social a {
  padding: 6px 14px;
  border: 1px solid var(--ln);
  border-radius: 999px;
  color: var(--ink);
  font-size: var(--font-size-sm);
  font-weight: 600;
}

.site-info-social a:hover {
  border-color: var(--navy);
  color: var(--navy);
}

.site-info-message {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  width: 100%;
  padding: 14px var(--spacing-lg);
  border: none;
  border-radius: var(--border-radius-lg);
  background-color: var(--color-primary);
  color: var(--ink);
  font-family: inherit;
  font-size: var(--font-size-base);
  font-weight: 700;
  cursor: pointer;
}

.site-info-message:hover:not(:disabled) {
  background-color: var(--pri-d);
}

.site-info-message:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.site-info-error {
  margin-bottom: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--border-radius);
  background-color: var(--err-bg);
  color: var(--err) !important;
  font-size: var(--font-size-sm);
  font-weight: 600;
}

@media (min-width: 860px) {
  .site-info-inner {
    grid-template-columns: 1.2fr 1fr;
    gap: calc(var(--spacing-xl) * 2);
    padding: calc(var(--spacing-xl) * 1.5) var(--spacing-lg);
  }

  .site-info-message {
    width: auto;
  }
}
