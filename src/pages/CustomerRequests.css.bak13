.cr-page { max-width: var(--max-width, 1200px); margin: 0 auto; padding: 24px 16px 48px; color: var(--color-text, #0f172a); }
.cr-hero {
  border-radius: 20px; padding: 28px 24px; margin-bottom: 20px; color: #fff;
  background: linear-gradient(135deg, var(--color-primary, #2563eb), var(--color-primary-dark, #1d4ed8));
}
.cr-hero h1 { margin: 0 0 8px; font-size: clamp(1.5rem, 4vw, 2.1rem); }
.cr-hero p { margin: 0 0 18px; max-width: 640px; opacity: 0.92; line-height: 1.55; }
.cr-how { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; }
.cr-how li { display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.16); border-radius: 99px; padding: 6px 14px 6px 6px; font-size: 0.88rem; }
.cr-how span { width: 24px; height: 24px; border-radius: 50%; background: #fff; color: var(--color-primary, #2563eb); display: grid; place-items: center; font-weight: 700; font-size: 0.8rem; }

.cr-toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 18px; }
.cr-search { flex: 1 1 260px; display: flex; align-items: center; gap: 8px; padding: 0 14px; border: 1px solid var(--color-border, #dbe4f3); border-radius: 12px; background: var(--color-surface, #fff); }
.cr-search:focus-within { border-color: var(--color-primary, #2563eb); box-shadow: 0 0 0 3px var(--color-primary-light, #eaf1ff); }
.cr-search svg { color: var(--color-text-light, #64748b); }
.cr-search input { flex: 1; border: 0; outline: 0; background: transparent; color: inherit; font: inherit; padding: 12px 0; }
.cr-filters { display: flex; gap: 8px; flex-wrap: wrap; }
.cr-filters button { padding: 8px 14px; border-radius: 99px; border: 1px solid var(--color-border, #dbe4f3); background: var(--color-surface, #fff); color: inherit; font: inherit; font-size: 0.88rem; cursor: pointer; }
.cr-filters button.on { background: var(--color-primary, #2563eb); border-color: var(--color-primary, #2563eb); color: #fff; }

.cr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 18px; }
.cr-card {
  display: flex; flex-direction: column; overflow: hidden; cursor: pointer; outline: none;
  background: var(--color-surface, #fff); border: 1px solid var(--color-border, #dbe4f3); border-radius: 18px;
  transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
}
.cr-card:hover, .cr-card:focus-visible { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(15, 42, 92, 0.12); border-color: var(--color-primary, #2563eb); }
.cr-skeleton { min-height: 360px; background: linear-gradient(90deg, var(--color-border, #e5ecf8) 25%, transparent 50%, var(--color-border, #e5ecf8) 75%); background-size: 200% 100%; animation: cr-shimmer 1.2s linear infinite; opacity: 0.5; cursor: default; }
.cr-cover { position: relative; aspect-ratio: 16 / 10; background: var(--color-primary-light, #eaf1ff); }
.cr-cover-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cr-cover-empty { width: 100%; height: 100%; display: grid; place-items: center; font-size: 3.2rem; color: var(--color-primary, #2563eb); opacity: 0.55; background: var(--color-primary-light, #eaf1ff); }
.cr-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
.cr-badges-abs { position: absolute; top: 10px; inset-inline-start: 10px; margin: 0; }
.cr-badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 99px; font-size: 0.75rem; font-weight: 700; }
.cr-badge-hot { background: #fee2e2; color: #b91c1c; }
.cr-badge-ok { background: #dcfce7; color: #15803d; }
.cr-count { position: absolute; bottom: 10px; inset-inline-end: 10px; background: rgba(15, 23, 42, 0.7); color: #fff; padding: 3px 10px; border-radius: 99px; font-size: 0.75rem; }
.cr-card-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
.cr-card-body h3 { margin: 0; font-size: 1.1rem; }
.cr-budget { margin: 0; font-weight: 700; color: var(--color-primary, #2563eb); }
.cr-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.cr-tag { background: var(--color-primary-light, #eaf1ff); color: var(--color-primary, #2563eb); padding: 3px 10px; border-radius: 99px; font-size: 0.78rem; font-weight: 600; }
.cr-card-note { margin: 0; font-size: 0.86rem; color: var(--color-text-light, #64748b); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cr-posted { margin: 0; display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: var(--color-text-light, #64748b); }
.cr-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 6px; }
.cr-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 14px; border-radius: 12px; cursor: pointer;
  border: 1px solid var(--color-border, #dbe4f3); background: var(--color-surface, #fff); color: var(--color-text, #0f172a);
  font: inherit; font-weight: 600; font-size: 0.9rem; text-decoration: none;
}
.cr-btn-wa { flex: 1; background: #16a34a; border-color: #16a34a; color: #fff; }

.cr-empty { text-align: center; padding: 48px 16px; color: var(--color-text-light, #64748b); }
.cr-empty > svg { font-size: 3rem; color: var(--color-primary, #2563eb); opacity: 0.6; }
.cr-empty h3 { color: var(--color-text, #0f172a); margin: 8px 0 4px; }
.cr-cta {
  margin-top: 32px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between;
  padding: 20px 22px; border-radius: 18px; background: var(--color-primary-light, #eaf1ff); border: 1px solid var(--color-border, #dbe4f3);
}
.cr-cta h3 { margin: 0 0 4px; }
.cr-cta p { margin: 0; color: var(--color-text-light, #64748b); }

.cr-backdrop { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(15, 42, 92, 0.55); backdrop-filter: blur(3px); }
.cr-modal { position: relative; width: 100%; max-width: 760px; max-height: 92vh; overflow-y: auto; background: var(--color-surface, #fff); color: var(--color-text, #0f172a); border-radius: 20px; box-shadow: 0 24px 70px rgba(15, 42, 92, 0.3); }
.cr-modal-x { position: absolute; top: 12px; inset-inline-end: 12px; z-index: 3; width: 36px; height: 36px; border-radius: 50%; border: 0; background: rgba(15, 23, 42, 0.65); color: #fff; display: grid; place-items: center; cursor: pointer; }
.cr-gallery { position: relative; aspect-ratio: 16 / 10; background: var(--color-primary-light, #eaf1ff); border-radius: 20px 20px 0 0; overflow: hidden; }
.cr-gallery img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cr-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 40px; height: 40px; border-radius: 50%; border: 0; background: rgba(255, 255, 255, 0.9); color: #0f172a; display: grid; place-items: center; cursor: pointer; }
.cr-prev { inset-inline-start: 12px; }
.cr-next { inset-inline-end: 12px; }
.cr-modal-body { padding: 18px 20px 22px; }
.cr-modal-body h2 { margin: 0 0 6px; font-size: 1.45rem; }
.cr-specs { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 14px 0; }
.cr-specs div { background: var(--color-primary-light, #eaf1ff); border-radius: 12px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; }
.cr-specs span { font-size: 0.75rem; color: var(--color-text-light, #64748b); }
.cr-block h3, .cr-contact h3 { margin: 12px 0 8px; font-size: 1rem; }
.cr-note { margin-top: 14px; padding: 12px 14px; border-radius: 12px; border-inline-start: 4px solid var(--color-primary, #2563eb); background: var(--color-primary-light, #eaf1ff); }
.cr-note p { margin: 4px 0 0; }
.cr-contact { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--color-border, #dbe4f3); }
.cr-contact p { margin: 0 0 10px; color: var(--color-text-light, #64748b); }

@media (max-width: 600px) {
  .cr-hero { padding: 22px 18px; border-radius: 16px; }
  .cr-backdrop { align-items: flex-end; padding: 0; }
  .cr-modal { max-width: none; border-radius: 20px 20px 0 0; max-height: 94vh; }
  .cr-cta { flex-direction: column; align-items: stretch; text-align: center; }
}
@keyframes cr-shimmer { to { background-position: -200% 0; } }
@media (prefers-reduced-motion: reduce) { .cr-skeleton { animation: none; } .cr-card { transition: none; } }